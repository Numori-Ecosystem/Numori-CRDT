# Numori CRDT — environment reference.
# Copy to .env and fill in your values.

# ─────────────────────────────────────────────────────────────────────────────
# Listener
# ─────────────────────────────────────────────────────────────────────────────
CRDT_PORT=3030
CRDT_HOST=0.0.0.0
# silent | error | warn | info | debug
CRDT_LOG_LEVEL=info

# Public origin clients reach this service on. Used only to log the exact connect
# URL for each app at startup, e.g. wss://crdt.example.com/notes. On Coolify, set
# this to ${SERVICE_FQDN_CRDT} so the generated domain is echoed back.
# CRDT_PUBLIC_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Storage
# ─────────────────────────────────────────────────────────────────────────────
# "postgres" for durable documents, "memory" for development only (documents are
# lost when the process exits).
CRDT_STORAGE=postgres

# Either a single connection string…
# DATABASE_URL=postgres://crdt:crdt@localhost:5434/crdt
# …or discrete variables:
POSTGRES_USER=crdt
POSTGRES_PASSWORD=crdt
POSTGRES_DB=crdt
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
# Set to "require" for managed providers with a self-signed internal CA,
# "disable" to turn TLS off entirely.
# PGSSLMODE=require

# Table holding Automerge chunks for every app (namespaced by app_id).
# CRDT_CHUNK_TABLE=crdt_chunks
# CRDT_PG_POOL_MAX=10

# ─────────────────────────────────────────────────────────────────────────────
# The app registry — who is allowed to use this service
# ─────────────────────────────────────────────────────────────────────────────
# Every hosted application is a tenant with its own signing key, its own
# Automerge Repo and its own storage namespace. Clients connect to
#
#   wss://<host>/<appId>?token=<jwt>
#
# Declare apps as JSON, inline or in a file. Prefer "secretEnv" over "secret" so
# no key material lives in the registry itself.
#
# Per-app fields:
#   id               required, lowercase slug; appears in the URL path
#   secretEnv        name of the env var holding the HS256 signing key
#   secret           the key itself (use secretEnv instead where possible)
#   requireAuth      default true; false runs an open server (development only)
#   documentBinding  "open" (default) or "strict" — see README
#   authz            "none" (default) or "webhook"
#   webhookUrl       authorization endpoint, required when authz=webhook
#   webhookSecretEnv env var holding the webhook signing key
#   webhookFailOpen  default false (an unreachable endpoint denies access)
#   audience         require a matching `app`/`aud` claim in the token
#   revokeChannel    Postgres NOTIFY channel to listen on (shared-database apps)
#   adminSecretEnv   env var holding an admin credential scoped to this app
#   storage          override the service-wide storage for this app
#   idleEvictMs      override the idle-document eviction window
#
CRDT_APPS=[{"id":"notes","secretEnv":"NOTES_JWT_SECRET"},{"id":"todo","secretEnv":"TODO_JWT_SECRET"}]
NOTES_JWT_SECRET=change-me-notes-signing-key
TODO_JWT_SECRET=change-me-todo-signing-key

# Or load the registry from a file (mutually exclusive with CRDT_APPS):
# CRDT_APPS_FILE=/etc/numori/apps.json

# Which app serves a request whose path does not name one. A single-app
# deployment gets this automatically, which is what lets an existing client that
# connects to "/collab" keep working unchanged.
# CRDT_DEFAULT_APP=notes

# ─────────────────────────────────────────────────────────────────────────────
# Defaults applied to every app (each app may override them)
# ─────────────────────────────────────────────────────────────────────────────
# CRDT_REQUIRE_AUTH=true
# CRDT_DOCUMENT_BINDING=open
# Expected `purpose` claim on incoming tokens.
# CRDT_TOKEN_PURPOSE=collab
# Evict idle documents from memory after this many ms (0 disables). Idle rooms
# stay durable in storage and reload on next access; keeps memory bounded.
CRDT_IDLE_EVICT_MS=300000

# ─────────────────────────────────────────────────────────────────────────────
# Admin API — POST /_admin/apps/:appId/revoke, GET /_admin/stats
# ─────────────────────────────────────────────────────────────────────────────
# Unset means the admin API does not exist. Minimum 16 characters.
# CRDT_ADMIN_SECRET=change-me-admin-credential

# ─────────────────────────────────────────────────────────────────────────────
# Limits
# ─────────────────────────────────────────────────────────────────────────────
# Largest accepted WebSocket message (bytes).
# CRDT_MAX_PAYLOAD_BYTES=104857600
# WebSocket ping interval. Collaboration sockets are long-lived and often idle,
# and reverse proxies close idle connections (Traefik defaults to 180s), so keep
# this well below the shortest idle timeout between client and server.
# CRDT_KEEPALIVE_MS=5000
# How long a graceful shutdown may take before the process exits anyway.
# CRDT_SHUTDOWN_GRACE_MS=10000

# ─────────────────────────────────────────────────────────────────────────────
# Single-app shorthand
# ─────────────────────────────────────────────────────────────────────────────
# If you omit CRDT_APPS entirely, one app is built from these instead:
# CRDT_APP_ID=default
# JWT_SECRET=change-me
# CRDT_AUTHZ=none
# CRDT_WEBHOOK_URL=
# CRDT_REVOKE_CHANNEL=
